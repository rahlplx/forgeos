# ForgeOS Environment Variables
# Copy to .env and fill in values
# Never commit .env — it's in .gitignore

# ── Cloudflare ─────────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── LLM Providers (LiteLLM 5-tier routing) ────────────────────────────────────
GROQ_API_KEY=                    # Tier 1: free 14,400 req/day
OPENROUTER_API_KEY=              # Tier 2: complex reasoning
KILOCODE_API_KEY=                # Tier 3: cost-optimised volume
ANTHROPIC_API_KEY=               # Tier 4: GRPO batch eval only

# ── Sandbox Coordinator (Oracle ARM) ──────────────────────────────────────────
SANDBOX_COORDINATOR_URL=         # https://YOUR_ORACLE_ARM_IP:8000
SANDBOX_SECRET=                  # HMAC secret for webhook auth

# ── Storage ───────────────────────────────────────────────────────────────────
DATABASE_URL=                    # PostgreSQL on Oracle ARM
QDRANT_URL=http://localhost:6333 # Qdrant on Oracle ARM
QDRANT_API_KEY=                  # optional if local

# ── Deploy ────────────────────────────────────────────────────────────────────
COOLIFY_URL=                     # https://YOUR_COOLIFY_INSTANCE
COOLIFY_TOKEN=                   # Coolify API token

# ── GitHub (OSS corpus + deploy) ──────────────────────────────────────────────
GITHUB_TOKEN=                    # PAT for RIS repo crawling
GITHUB_WEBHOOK_SECRET=           # for commit-triggered re-index

# ── Notifications ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=              # optional: RAM ceiling alerts
TELEGRAM_CHAT_ID=                # your chat ID
